# Prisma Config #
# MySQL. Replace the placeholders. Do not commit a real .env file.
DATABASE_URL="mysql://username:password@localhost:3306/my_academy"

# Direct connection to the database. Used for migrations.
DIRECT_URL="mysql://username:password@localhost:3306/my_academy"

# Next Auth Config #
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_BASE_PATH=http://localhost:3000/
NEXTAUTH_URL=http://localhost:3000/
NEXTAUTH_SECRET=your_nextauth_secret_here
# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Storage Configuration (AWS S3 or DigitalOcean Spaces)
STORAGE_TYPE=local

STORAGE_ACCESS_KEY_ID=your_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_secret_access_key
STORAGE_REGION=us-east-1
STORAGE_BUCKET=your_bucket_name
STORAGE_ENDPOINT=https://your-endpoint.com
STORAGE_FORCE_PATH_STYLE=false
STORAGE_CDN_URL=https://your-cdn.com

# SMTP Credentials
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password

# Additional Optional Settings
SMTP_SENDER=My Academy
SMTP_FROM=your_email@example.com

# Google reCAPTCHA v2
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_public_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Base URL
BASE_URL = /

# Optional. Coach comment drafts use a built-in draft when this is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini